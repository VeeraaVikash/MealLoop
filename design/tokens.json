    "bg/scrim": {
      "light": "#1B191666",
      "dark": "#000000A3",
      "lightRef": "scrim-light",
      "darkRef": "scrim-dark",
      "usage": "Behind sheets and alerts"
    },
    "bg/pressed": {
      "light": "#1B19160F",
      "dark": "#EFE9DD14",
      "lightRef": "press-light",
