    "turmeric-dark": "#F0B84A",
    "turmeric-soft-dark": "#30271A",
    "chilli-dark": "#FF7A63",
    "chilli-soft-dark": "#35201B",
    "scrim-light": "#1B191666",
    "scrim-dark": "#000000A3",
    "press-light": "#1B19160F",
    "press-dark": "#EFE9DD14"
