    "ink-2": "#5B554C",
    "ink-3": "#8C857A",
    "ink-3-text": "#6A6459",
    "rule": "#DDD4C4",
    "curry-leaf": "#2F5D3A",
    "curry-leaf-deep": "#244A2E",
    "curry-leaf-soft": "#E3EBDD",
